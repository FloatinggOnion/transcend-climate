# Transcend Climate — everything here is OPTIONAL. With no .env at all the app runs
# keyless: NASA imagery + NASA POWER + Climate TRACE + the free rule-based command parser.
# Copy to .env and uncomment what you need. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=8787
# HOST=127.0.0.1                 # 0.0.0.0 to expose; then ALSO set ALLOWED_HOSTS
# ALLOWED_HOSTS=climate.example.org
# TRUST_PROXY=true               # only when behind a reverse proxy you control
# CORS_ORIGINS=                  # comma list; empty = same-origin only
# CACHE_DIR=.tc-cache

# ── Place search fallback (OpenStreetMap Nominatim; usage policy requires an identifying agent) ──
# GEOCODER=nominatim             # or "off"
# GEOCODER_USER_AGENT=TranscendClimate/0.1 (https://your-site.example; you@example.org)

# ── Natural-language understanding (pick ONE provider; none = rule parser only) ──
# NLP_PROVIDER=auto              # auto | anthropic | openai | compatible | offline
# Anthropic (Claude). Default model is claude-opus-5-5. For this tool-routing job the cheaper
# claude-sonnet-5-5 or claude-haiku-5-5 are usually plenty — your call.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low           # low|medium|high|xhigh|max; "off" to omit (older models)
# ANTHROPIC_FALLBACKS=default    # "off" to disable server-side refusal fallback
# OpenAI (model has no default on purpose: ids change)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, Together, Groq…)
# NLP_BASE_URL=http://localhost:11434/v1
# NLP_MODEL=
# NLP_API_KEY=
# Cost guards
# NLP_DAILY_REQUEST_BUDGET=500   # hard cap on paid model calls per UTC day, all users (0 = unlimited)
# RATE_LIMIT_NLP_PER_MIN=20
# RATE_LIMIT_API_PER_MIN=240

# ── Ground-station air quality (free key from https://openaq.org) ──
# OPENAQ_API_KEY=

# ── Optional map upgrades. These two are sent to the BROWSER by design: restrict them by referrer. ──
# CESIUM_ION_TOKEN=              # enables Bing aerial + Cesium World Terrain
# GOOGLE_MAPS_API_KEY=           # enables Google Photorealistic 3D Tiles
# TERRAIN=reearth                # or "flat"

{
  "name": "transcend-climate",
  "version": "0.1.0",
  "private": true,
  "description": "Open climate-monitoring globe for Nigeria and Africa: live NASA/Copernicus-class climate layers, emissions, air quality and deforestation, with multilingual natural-language control.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-reporter=spec \"server/**/*.test.js\" \"shared/**/*.test.js\" \"src/**/*.test.js\" \"scripts/**/*.test.js\" \"test/**/*.test.js\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:provenance": "node scripts/verify-provenance.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "postbuild": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "cesium": "1.146.0"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
